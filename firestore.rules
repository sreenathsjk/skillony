rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data) {
      return data.uid == request.auth.uid
        && data.email is string
        && data.email.size() <= 256
        && (data.displayName == null || (data.displayName is string && data.displayName.size() <= 128))
        && (data.hasCompletedOnboarding == null || data.hasCompletedOnboarding is bool)
        && (data.daysTilInterview == null || data.daysTilInterview is int)
        && (data.dailyMissions == null || data.dailyMissions is list)
        && (data.activeStreak == null || data.activeStreak is int)
        && (data.onboarding == null || data.onboarding is map)
        && (data.premiumTier == null || (data.premiumTier is string && data.premiumTier.size() <= 32))
        && (data.speakingCount == null || data.speakingCount is int)
        && (data.interviewCount == null || data.interviewCount is int)
        && (data.missionConfidenceScores == null || data.missionConfidenceScores is map);
    }

    // Users collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data);
      allow delete: if false; // Users cannot be deleted from typical client sessions
    }
  }
}
